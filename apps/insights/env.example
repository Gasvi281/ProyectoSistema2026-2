# Backend de Homelitics
BACKEND_URL=https://homelitics-api.onrender.com

# LLM: fake (sin red, para tests/dev) | gemini
INSIGHTS_LLM_MODE=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Intentos totales contra Gemini por llamada (1 = sin reintentos; mínimo 1)
INSIGHTS_LLM_MAX_RETRIES=1
# Timeout por intento a Gemini, en segundos
INSIGHTS_LLM_TIMEOUT=60

# Origenes permitidos para el panel web (lista separada por comas)
INSIGHTS_CORS_ORIGINS=http://localhost:5173

# Observabilidad con Langfuse (opcional): sin PUBLIC y SECRET queda desactivada.
# Keys: cloud.langfuse.com -> tu proyecto -> Settings -> API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Si se deja vacío, el SDK usa Langfuse Cloud por defecto.
LANGFUSE_BASE_URL=

# Solo dev: usadas por scripts/get_token.py para obtener un JWT de un TEAM_ADMIN
SUPABASE_URL=
SUPABASE_ANON_KEY=
INSIGHTS_DEV_EMAIL=
INSIGHTS_DEV_PASSWORD=
