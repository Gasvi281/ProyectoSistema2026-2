GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AGENT_LLM_MODE=fake

# --- Backend (Homelitics API) ---

# "fake" (default): sin HTTP, útil para desarrollo y pruebas sin backend.
# "http": llama al backend real.
AGENT_SLOTS_MODE=fake          # fake | http
APPOINTMENT_BOOKING_MODE=fake  # fake | http

BACKEND_URL=                   # e.g. https://homelitics-api.onrender.com

# Token JWT estático para el backend. Requerido por backend_auth.py:27,53
# y por los tests actuales cuando AGENT_SLOTS_MODE=http o
# APPOINTMENT_BOOKING_MODE=http. Alternativa: usa DEV_AGENT_ID (ver abajo).
BACKEND_SERVICE_TOKEN=

# Reservado para 3.9 (provider JWT de Supabase) — aún no leído
# por ningún código del repo.
SUPABASE_URL=
SUPABASE_ANON_KEY=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ID del agente usado para consultas de disponibilidad (check_agent_availability).
# NOTA: NO es un mecanismo de autenticación — X-Dev-Agent-Id devuelve 401
# contra el backend desplegado. Quitar antes de la entrega final.
DEV_AGENT_ID=
