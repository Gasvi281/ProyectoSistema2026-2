# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Secreto inventado por ti, para verificar que las peticiones
# realmente vienen de Telegram
TELEGRAM_WEBHOOK_SECRET=un-secreto-largo-y-aleatorio

# API key gratuita de Google AI Studio (Gemini)
GEMINI_API_KEY=tu_api_key_de_gemini

# Agente conversacional E6: "fake" (sin API, respuestas de prueba)
# o "gemini" (llama a Gemini real, requiere GEMINI_API_KEY)
AGENT_LLM_MODE=gemini

# Modelo de Gemini usado por el agente (sobrescribe el default del paquete)
GEMINI_MODEL=gemini-2.0-flash
