# ---------------------------------------------------------------------------
# Un solo .env para todo el proyecto (webhook + agente), porque desde que
# corren en un mismo proceso (uv workspace), config.py solo carga el .env
# de la carpeta raíz — las variables del agente tienen que estar aquí
# también, no alcanza con apps/agent/.env.
#
# apps/agent/.env.example sigue existiendo aparte, útil solo si corres el
# agente de forma standalone (consola / tests), sin el webhook.
# ---------------------------------------------------------------------------

# --- Webhook / Telegram ---

# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Secreto inventado por ti, para verificar que las peticiones
# realmente vienen de Telegram
TELEGRAM_WEBHOOK_SECRET=un-secreto-largo-y-aleatorio

# Se mantiene por compatibilidad con ai_service.py (ya no se usa en el
# flujo normal — el agente responde ahora — pero config.py la sigue
# exigiendo al arrancar).
GEMINI_API_KEY=tu_api_key_de_gemini

# --- Agente conversacional (apps/agent) ---

# API key de Gemini que usa el agente (LangChain). Puede ser la misma
# que GEMINI_API_KEY de arriba.
GOOGLE_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.6-flash

# "fake": respuestas simples basadas en palabras clave, sin llamar a
#   Gemini — útil para probar el webhook sin gastar cuota.
# "gemini": el agente real, con búsqueda de propiedades, agendamiento, etc.
AGENT_LLM_MODE=fake

# Imprime en stderr cada herramienta que invoca el agente, sus argumentos y
# el resultado devuelto. Solo activo en modo gemini (LangGraph).
# "true" | "1" | "yes" para activar; cualquier otro valor (o ausente) = off.
AGENT_DEBUG=false

# --- Notificaciones al agente humano por correo (SMTP) ---

# "fake" (default): no manda correos reales, solo los guarda en memoria.
# "email": manda correos reales usando los datos de abajo.
NOTIFICATIONS_MODE=fake

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Correo del agente inmobiliario humano que debe recibir el aviso
AGENT_NOTIFICATION_EMAIL=

# --- Backend (Homelitics API) ---

# "fake" (default): sin HTTP, útil para desarrollo y pruebas sin backend.
# "http": llama al backend real.
AGENT_SLOTS_MODE=fake                  # fake | http
APPOINTMENT_BOOKING_MODE=fake          # fake | http
CLIENT_RESOLVER_MODE=fake              # fake | http (http usa POST /clients create-or-get por telegram_user_id)
LEAD_MODE=fake                         # fake | http
# Debe coincidir con LEAD_MODE: si LEAD_MODE=http, este también debe ser http.
# El resolver fake arranca vacío y no puede proveer el agency_id que HttpLead
# necesita — la app rechaza esa combinación al arrancar.
LISTING_AGENCY_RESOLVER_MODE=fake      # fake | http
# Búsqueda de propiedades. http = catálogo real de la agencia del bot (requiere AGENCY_ID).
# Solo intra-agencia (limitación conocida, alcance MVP): el backend no expone búsqueda
# cross-agency. Si LEAD_MODE=http, este también debe ser http — mezclarlos produce
# UNKNOWN_LISTING al primer turno (app lo rechaza al arrancar).
LISTING_SEARCH_MODE=fake               # fake | http

BACKEND_URL=                   # e.g. https://homelitics-api.onrender.com

# Agencia a la que pertenece este bot (un bot por agencia). Se envía como
# header X-Agency-Id en cada petición. Requerido en modos http.
AGENCY_ID=

# --- Autenticación del bot contra el backend ---
# backend_auth.py usa el primer mecanismo configurado, en este orden:
#   1. BOT_EMAIL + BOT_PASSWORD  (recomendado: JWT de Supabase que se renueva solo)
#   2. BACKEND_SERVICE_TOKEN     (JWT estático; expira y hay que reemplazarlo a mano)
#   3. DEV_AGENT_ID              (bypass solo local; el backend desplegado responde 401)
# BOT_EMAIL y BOT_PASSWORD van juntos: si solo hay uno, la app falla al arrancar.

# Cuenta de servicio del bot (pídela al Backend Lead)
BOT_EMAIL=
BOT_PASSWORD=

# Proyecto de Supabase donde se hace el login de la cuenta de servicio
# (leídos por jwt_provider.py).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Alternativas de auth (normalmente vacías)
BACKEND_SERVICE_TOKEN=
DEV_AGENT_ID=

# --- Observabilidad con Langfuse (opcional) ---
# Si se omiten las dos keys, el tracing queda deshabilitado completamente.
# Obtén las keys en: https://cloud.langfuse.com → tu proyecto → Settings → API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Por defecto apunta a Langfuse Cloud. Cambia solo si usas una instancia
# self-hosted.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
