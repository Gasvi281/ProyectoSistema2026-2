# ---------------------------------------------------------------------------
# Un solo .env para todo el proyecto (webhook + agente), porque desde que
# corren en un mismo proceso (uv workspace), config.py solo carga el .env
# de la carpeta raíz — las variables del agente tienen que estar aquí
# también, no alcanza con apps/agent/.env.
#
# apps/agent/.env.example sigue existiendo aparte, útil solo si corres el
# agente de forma standalone (consola / tests), sin el webhook.
# ---------------------------------------------------------------------------

# --- Webhook / Telegram ---

# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Secreto inventado por ti, para verificar que las peticiones
# realmente vienen de Telegram
TELEGRAM_WEBHOOK_SECRET=un-secreto-largo-y-aleatorio

# Se mantiene por compatibilidad con ai_service.py (ya no se usa en el
# flujo normal — el agente responde ahora — pero config.py la sigue
# exigiendo al arrancar).
GEMINI_API_KEY=tu_api_key_de_gemini

# --- Agente conversacional (apps/agent) ---

# API key de Gemini que usa el agente (LangChain). Puede ser la misma
# que GEMINI_API_KEY de arriba.
GOOGLE_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.6-flash

# "fake": respuestas simples basadas en palabras clave, sin llamar a
#   Gemini — útil para probar el webhook sin gastar cuota.
# "gemini": el agente real, con búsqueda de propiedades, agendamiento, etc.
AGENT_LLM_MODE=fake

# --- Notificaciones al agente humano por correo (SMTP) ---

# "fake" (default): no manda correos reales, solo los guarda en memoria.
# "email": manda correos reales usando los datos de abajo.
NOTIFICATIONS_MODE=fake

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Correo del agente inmobiliario humano que debe recibir el aviso
AGENT_NOTIFICATION_EMAIL=
